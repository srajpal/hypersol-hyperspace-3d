<holoml version="0.2">
  <head>
    <title>HoloML: a long text view</title>
  </head>
  <!-- Review 134, V8: eighty labels, so the text view is longer than the window. There the arrow keys,
       Page Up, Page Down, and the space bar scroll the text; the scene behind takes no keys and draws nothing. -->
  <scene background="#1c2030">
    <viewpoint position="0 1.6 4" look-at="0 1.6 -6" mode="walk" />
    <light type="ambient" intensity="0.8" />
    <label id="l0" position="-4.5 1 -6">Line 1 of the text view</label>
    <label id="l1" position="-3.5 1 -6">Line 2 of the text view</label>
    <label id="l2" position="-2.5 1 -6">Line 3 of the text view</label>
    <label id="l3" position="-1.5 1 -6">Line 4 of the text view</label>
