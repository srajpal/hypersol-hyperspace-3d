<holoml version="0.3">
  <head>
    <title>HoloML: compressed models</title>
  </head>
  <!-- Milestone 25, check HL4: models compressed with Draco and meshopt, and one with a KTX2 picture. -->
  <scene background="#1c2030">
    <viewpoint position="0 1 6" look-at="0 0.5 0" />
    <light type="ambient" intensity="1" />
    <model id="draco" src="draco-box.gltf" position="-3 0.5 0" />
    <model id="meshopt" src="meshopt-box.glb" position="0 0.5 0" />
    <model id="ktx2" src="ktx2-box.gltf" position="3 0.5 0" />
  </scene>
</holoml>
