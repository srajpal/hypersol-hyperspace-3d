<holoml version="0.2">
  <head>
    <title>HoloML: a compressed model that cannot be decoded</title>
  </head>
  <!-- Milestone 25, check HL4: a Draco model whose data is spoiled is left out with a notice; the rest shows.
       A 0.2 page: reading compressed models is the renderer's, not the language's. -->
  <scene background="#1c2030">
    <viewpoint position="0 1 6" look-at="0 0.5 0" />
    <light type="ambient" intensity="1" />
    <model id="broken" src="broken-draco.gltf" position="-1.5 0.5 0" />
    <model id="fine" src="draco-box.gltf" position="1.5 0.5 0" />
  </scene>
</holoml>
