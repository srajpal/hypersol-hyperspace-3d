<holoml version="0.2">
  <head>
    <title>HoloML fade, second page</title>
  </head>
  <!-- Milestone 19 (V5): arriving through a fade, dark until its model (held by the check) has arrived. -->
  <scene background="#d8e4ee">
    <viewpoint position="0 1.2 4" look-at="0 0.6 0" />
    <light type="ambient" intensity="0.8" />
    <model id="car" src="gen/late-car.gltf?gate=fade-b" />
    <a href="fade-a.holoml">
      <label position="0 2.2 0" size="0.2">Back</label>
    </a>
  </scene>
</holoml>
