<holoml version="0.2">
  <head>
    <title>HoloML stand-ins</title>
    <script src="stand-in.js" />
  </head>
  <scene background="#1c2030">
    <viewpoint position="0 1.4 6" look-at="0 0.5 0" />
    <light type="ambient" intensity="0.8" />
    <light type="directional" position="4 8 5" look-at="0 0 0" intensity="1.2" />
    <!-- The car arrives when the check lets it; the orange block stands in until then. -->
    <model id="car" src="gen/late-car.gltf?gate=stand-in" stand-in="models/stand-in.gltf" />
  </scene>
</holoml>
