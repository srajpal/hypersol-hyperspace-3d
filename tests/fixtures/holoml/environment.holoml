<holoml version="0.2">
  <head>
    <title>HoloML surroundings</title>
  </head>
  <!-- A green panorama lights the scene; a mirror-like block reflects it. -->
  <scene background="#1c2030" environment="gen/panorama.hdr">
    <viewpoint position="0 1 2.2" look-at="0 1 0" />
    <light type="ambient" intensity="0.6" />
    <model id="mirror" src="blockworld/models/stone.gltf" position="0 1 0" rotation="0 30 0">
      <material name="stone" metalness="1" roughness="0.25" />
    </model>
  </scene>
</holoml>
