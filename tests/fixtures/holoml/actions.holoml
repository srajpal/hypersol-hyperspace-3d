<holoml version="0.2">
  <head>
    <title>HoloML click actions</title>
    <script src="actions.js" />
  </head>
  <!-- Milestone 19 (V3): a door that opens and closes with a sound, a switch for a lamp, and a box that spins once a click. -->
  <scene background="#1c2030">
    <viewpoint position="0 1.3 3.2" look-at="0 1.1 0" />
    <light type="ambient" intensity="0.5" />
    <light id="lamp" type="point" position="0 2.4 1" intensity="0" range="8" color="#ffd9a0" />
    <group id="hinge" position="-0.45 0 0">
      <model id="door" src="blockworld/models/planks.gltf" position="0.45 1 0" scale="0.9 2 0.06" />
    </group>
    <animate target="#hinge" attribute="rotation" to="0 90 0" duration="0.8s" begin="click" trigger="#door" toggle label="Bedroom door" />
    <sound id="creak" src="gen/tone.wav" begin="click" trigger="#door" volume="0.3" />
    <model id="switch" src="blockworld/models/stone.gltf" position="1.3 1.2 0" scale="0.2 0.3 0.06" />
    <animate target="#lamp" attribute="intensity" from="0" to="1.5" duration="0.2s" begin="click" trigger="#switch" toggle label="Hall light" />
    <model id="box" src="blockworld/models/sand.gltf" position="-1.4 0.5 0.5" scale="0.5" />
    <animate target="#box" attribute="rotation" from="0 0 0" to="0 360 0" duration="1s" begin="click" />
  </scene>
</holoml>
