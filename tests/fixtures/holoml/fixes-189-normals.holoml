<holoml version="0.3">
  <head>
    <title>HoloML: which way a surface faces, under a stretch</title>
  </head>
  <!-- Issue #67: a hit's normal stays square to the surface when a
       parent's scale differs by axis, for a model drawn on its own (the
       spinner, which has an animation) and one drawn as an instance (the
       stand-in box, which has none), under turned groups. -->
  <scene>
    <viewpoint position="0 1 8" look-at="0 0 0" />
    <group position="20 0 0" scale="2 1 1">
      <model id="cloned" src="models/spinner.gltf" rotation="0 45 0" />
    </group>
    <group position="-20 0 0" rotation="0 20 0">
      <group scale="1 1 3">
        <model id="instanced" src="models/stand-in.gltf" rotation="0 35 0" />
      </group>
    </group>
  </scene>
</holoml>
