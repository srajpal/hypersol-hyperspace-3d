<holoml version="0.2">
  <head>
    <title>HoloML: things a script hides</title>
  </head>
  <!-- Review 134, V10: a thing with visible = false takes no click, hover, or link, and stops no one,
       whether it is drawn as an instance (the blocks of the wall, and the linked block) or as its own
       copy (the linked car, which changes a material). The walker starts facing the wall. -->
  <scene background="#1c2030">
    <viewpoint position="0.5 1.6 3" look-at="0.5 1.2 -5" mode="walk" />
    <light type="ambient" intensity="0.8" />
    <light type="directional" position="3 10 6" look-at="0 0 0" />
    <group id="wall" solid>
      <model id="w1" src="blockworld/models/planks.gltf" position="-0.5 0.5 0" />
      <model id="w2" src="blockworld/models/planks.gltf" position="0.5 0.5 0" />
      <model id="w3" src="blockworld/models/planks.gltf" position="1.5 0.5 0" />
      <model id="w4" src="blockworld/models/planks.gltf" position="-0.5 1.5 0" />
      <model id="w5" src="blockworld/models/planks.gltf" position="0.5 1.5 0" />
      <model id="w6" src="blockworld/models/planks.gltf" position="1.5 1.5 0" />
    </group>
    <a href="second.holoml">
      <model id="car" src="models/placeholder-car.gltf" position="-3.5 0 -3">
        <material name="Paint" color="#c0182a" />
      </model>
    </a>
    <a href="second.holoml#top">
      <model id="block" src="blockworld/models/grass.gltf" position="4 1.2 -2" />
    </a>
  </scene>
</holoml>
