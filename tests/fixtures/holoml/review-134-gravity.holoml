<holoml version="0.2">
  <head>
    <title>HoloML: a walker standing still</title>
  </head>
  <!-- Review 134, V7: a walk page with gravity. Once the walker has landed and nothing moves, no frame is drawn. -->
  <scene background="#1c2030">
    <viewpoint position="0.5 4 0.5" look-at="0.5 3 -5" mode="walk" gravity jump />
    <light type="ambient" intensity="0.8" />
    <group id="floor" solid>
      <model src="blockworld/models/stone.gltf" position="0.5 0.5 0.5" />
      <model src="blockworld/models/stone.gltf" position="0.5 0.5 -0.5" />
      <model id="ahead" src="blockworld/models/stone.gltf" position="0.5 0.5 -1.5" />
    </group>
    <label id="sign" position="0.5 3 -4">Standing still</label>
  </scene>
</holoml>
