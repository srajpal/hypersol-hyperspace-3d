<holoml version="0.2">
  <head>
    <title>HoloML script</title>
    <script src="script-basic.js" />
  </head>
  <scene>
    <viewpoint position="0 1.6 7" look-at="0 1 0" mode="orbit" />
    <light id="lamp" type="point" position="0 3 2" intensity="0" />
    <label id="sign" position="0 2.4 0">Written in the page</label>
    <model id="car" src="models/placeholder-car.gltf" />
    <model id="gone" src="models/spinner.gltf" position="3 0 0" />
    <group id="stand" position="-3 0 0" />
    <hud id="score" corner="top-right">Score: 0</hud>
  </scene>
</holoml>
