<holoml version="0.2">
  <head>
    <title>HoloML shadows</title>
  </head>
  <!-- A light from high above, and two blocks over a floor: the left one is
       marked shadows and darkens the floor under it; the right one is not. -->
  <scene background="#1c2030">
    <viewpoint position="0 5 7" look-at="0 0.5 0" />
    <light type="ambient" intensity="0.4" />
    <light type="directional" position="0.5 10 1" look-at="0 0 0" shadows />
    <model id="floor" src="blockworld/models/stone.gltf" position="0 -0.5 0" scale="8 1 6" shadows />
    <model id="casting" src="blockworld/models/stone.gltf" position="-1.6 1.5 0" shadows />
    <model id="plain" src="blockworld/models/stone.gltf" position="1.6 1.5 0" />
    <!-- Points on the floor under each block (the middle of the left one's shadow), in view. -->
    <group id="under-casting" position="-1.6 0 -0.1" />
    <group id="under-plain" position="1.6 0 -0.1" />
  </scene>
</holoml>
