<holoml version="0.2">
  <head>
    <title>HoloML water</title>
  </head>
  <!-- A tank of water 10 m wide, 4 m high, and 16 m deep, seen through its
       front from 3 m outside. Three red blocks: "near" 1 m inside the
       front, "far" 10 m inside, and "outside" between the viewer and the
       tank, out of the water. -->
  <scene background="#101820">
    <viewpoint position="0 1.6 11" look-at="0 1.2 0" />
    <light type="ambient" intensity="0.5" />
    <light type="directional" position="1 10 3" look-at="0 0 0" intensity="1.4" />
    <water position="0 -0.2 0" size="10 4.2 16" color="#1f6f8b" clarity="12" />
    <model id="floor" src="blockworld/models/sand.gltf" position="0 -0.5 0" scale="10 1 16" />
    <model id="near" src="blockworld/models/sand.gltf" position="-1.4 1.2 7">
      <material name="sand" map="gen/stripes.png?n=1&amp;a=e02020&amp;b=e02020" />
    </model>
    <model id="far" src="blockworld/models/sand.gltf" position="1.4 1.2 -2">
      <material name="sand" map="gen/stripes.png?n=1&amp;a=e02020&amp;b=e02020" />
    </model>
    <model id="outside" src="blockworld/models/sand.gltf" position="1.2 1.2 8.8" scale="0.5">
      <material name="sand" map="gen/stripes.png?n=1&amp;a=e02020&amp;b=e02020" />
    </model>
  </scene>
</holoml>
