{
  "name": "hypersol-hyperspace-3d",
  "private": true,
  "version": "0.9.1",
  "description": "HyperSol HyperSpace 3D: an open-source desktop browser with a 3D interface.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @hypersol/browser dev",
    "build": "pnpm --filter @hypersol/browser build",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "test:linux": "node tests/linux/run.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/scene-core --noEmit && tsc -p packages/themes --noEmit && tsc -p packages/holoml --noEmit && tsc -p apps/browser --noEmit && tsc -p apps/android --noEmit && tsc -p tests --noEmit && tsc -p site --noEmit",
    "screenshots": "pnpm build && vitest run --config vitest.shots.config.ts",
    "screenshots:readme": "pnpm build && vitest run --config vitest.readme.config.ts",
    "screenshots:examples": "pnpm build && vitest run --config vitest.examples.config.ts",
    "screenshots:video": "pnpm build && vitest run --config vitest.video.config.ts && node tests/screenshots/video-encode.mjs",
    "filters:update": "pnpm --filter @hypersol/browser filters:update",
    "holoml:sync": "node packages/holoml/sync.mjs",
    "site:build": "pnpm build && node site/build.mjs",
    "package": "pnpm build && node apps/browser/scripts/package.mjs",
    "package:smoke": "node apps/browser/scripts/smoke.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
